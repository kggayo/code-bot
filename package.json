{
  "name": "code-bot",
  "version": "0.3.0",
  "private": true,
  "description": "Desktop code orchestrator: a main bot that hands work to project bots, which run coding sub-agents in your project folders.",
  "author": "code-bot",
  "license": "MIT",
  "homepage": "https://github.com/kggayo/code-bot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kggayo/code-bot.git"
  },
  "bugs": {
    "url": "https://github.com/kggayo/code-bot/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "code-bot": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "e2e": "electron-vite build && node scripts/e2e.ts",
    "live": "electron-vite build && node scripts/live-check.ts",
    "package": "electron-vite build && electron-builder --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
